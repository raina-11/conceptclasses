# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details
# Get these values from Firebase Console > Project Settings > Your apps > Web app

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration
# Sign up at https://cloudinary.com (free tier)
# Cloud name: Dashboard > top-left shows your cloud name
# Upload preset: Settings > Upload > Upload presets > Add unsigned preset
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Scholarship Registration API (Google Apps Script Web App URL)
REACT_APP_SCHOLARSHIP_API_URL=https://script.google.com/macros/s/AKfycbw1CCSO9XBJ7vhqWsYVYT4LxkmGPP_g_bQt9_Y0H0z1wPfylvCJS-ufBDOGLx5aS2E_mg/exec

# Student portal (defaults to this production URL when omitted)
REACT_APP_STUDENT_PORTAL_URL=https://students.conceptinstitute.co.in
